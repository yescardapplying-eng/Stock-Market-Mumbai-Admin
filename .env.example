# ==============================================================
# STOCK MARKET MUMBAI ADMIN — RENDER.COM CONFIGURATION
# ==============================================================

# Admin Authentication Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Mumbai@2026#Admin
AUTH_SECRET=SMM_Session_HMAC_Secret_2026_Change_In_Prod

# Live Lead Ingestion Secret (must match main website's ADMIN_INGEST_SECRET on Hostinger)
ADMIN_INGEST_SECRET=SMM_Admin_Ingest_2026_Secret_Key

# Allowed Origin for Main Website CORS (Hostinger domain)
ALLOWED_ORIGIN=https://stockmarketmumbai.in

# Runtime Environment (Render sets PORT automatically — do NOT hardcode PORT on Render)
NODE_ENV=production

# Optional Persistent Disk folder on Render (if using paid Render Disk, e.g. /var/data)
DATA_DIR=

# --------------------------------------------------------------
# MYSQL DATABASE CONFIGURATION (Recommended for Render Free Tier)
# Connect Hostinger Remote MySQL or free TiDB Cloud so leads persist across Render restarts
# --------------------------------------------------------------
DB_HOST=
DB_PORT=3306
DB_NAME=stock_market_mumbai
DB_USER=root
DB_PASS=
DB_SSL=false
